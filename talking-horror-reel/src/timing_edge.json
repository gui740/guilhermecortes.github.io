{
 "duration": 35.83,
 "segments": [
  {
   "id": "hook",
   "text": "Três filmes, três maldições, e a última cê não assiste sozinho.",
   "start": 0.0,
   "end": 3.88
  },
  {
   "id": "th1",
   "text": "Primeira parada: Tailândia.",
   "start": 4.16,
   "end": 5.66
  },
  {
   "id": "th2",
   "text": "O autor jura que aconteceu na família dele: um sussurro de noite, e a irmã muda.",
   "start": 5.9,
   "end": 10.25
  },
  {
   "id": "th3",
   "text": "Quando a Morte Sussurra. Tá na Netflix.",
   "start": 10.59,
   "end": 12.96
  },
  {
   "id": "send",
   "text": "Manda pra quem acha que terror bom só vem de Hollywood.",
   "start": 13.26,
   "end": 15.92
  },
  {
   "id": "fm1",
   "text": "Agora a gente desce pra Indonésia.",
   "start": 16.2,
   "end": 17.86
  },
  {
   "id": "fm2",
   "text": "Existe o pesugihan: pacto de riqueza pago com sangue.",
   "start": 18.1,
   "end": 21.25
  },
  {
   "id": "fm3",
   "text": "Fortuna Maldita. Netflix também.",
   "start": 21.59,
   "end": 23.84
  },
  {
   "id": "im1",
   "text": "E sem sair da ilha:",
   "start": 24.14,
   "end": 25.37
  },
  {
   "id": "im2",
   "text": "Impetigore.",
   "start": 25.69,
   "end": 26.34
  },
  {
   "id": "im3",
   "text": "Uma herança, um teatro de sombras e uma vila que quer ela morta.",
   "start": 26.56,
   "end": 29.78
  },
  {
   "id": "im4",
   "text": "Pra alugar na Apple TV.",
   "start": 30.02,
   "end": 31.35
  },
  {
   "id": "q",
   "text": "Qual desses lugares cê não visitaria de jeito nenhum?",
   "start": 31.67,
   "end": 34.07
  },
  {
   "id": "cta",
   "text": "Segue a Talking Horror.",
   "start": 34.29,
   "end": 35.53
  }
 ],
