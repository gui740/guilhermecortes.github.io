    "text": "Três found footage que parecem gravação de verdade.",
    "t": 0.06,
    "e": 2.92,
    "w0": 0,
    "w1": 8
   },
   {
    "id": "h2",
    "text": "E o último, cê não termina sozinho.",
    "t": 3.14,
    "e": 5.46,
    "w0": 8,
    "w1": 15
   },
   {
    "id": "a1",
    "text": "Número três:",
    "t": 5.86,
    "e": 6.77,
    "w0": 15,
    "w1": 17
   },
   {
    "id": "a2",
    "text": "A Bruxa de Blair.",
    "t": 7.19,
    "e": 8.24,
    "w0": 17,
    "w1": 21
   },
   {
    "id": "a3",
    "text": "Três estudantes entram numa floresta pra gravar um documentário,",
    "t": 8.74,
    "e": 11.94,
    "w0": 21,
    "w1": 30
   },
   {
    "id": "a4",
    "text": "e somem.",
    "t": 12.24,
    "e": 12.9,
    "w0": 30,
    "w1": 32
   },
   {
    "id": "a5",
    "text": "Em noventa e nove, o site do filme dizia que eles tinham desaparecido de verdade.",
    "t": 13.28,
    "e": 17.6,
    "w0": 32,
    "w1": 47
   },
   {
    "id": "a6",
    "text": "E muita gente acreditou.",
    "t": 17.9,
    "e": 19.35,
    "w0": 47,
    "w1": 51
   },
   {
    "id": "a7",
    "text": "Tá na Netflix.",
    "t": 19.75,
    "e": 20.87,
    "w0": 51,
    "w1": 54
   },
   {
    "id": "m1",
    "text": "E o próximo é pior.",
    "t": 21.32,
    "e": 22.52,
    "w0": 54,
    "w1": 59
   },
   {
    "id": "b1",
    "text": "Número dois:",
    "t": 22.92,
    "e": 23.87,
    "w0": 59,
    "w1": 61
   },
   {
    "id": "b2",
    "text": "Entrevista com o Demônio.",
    "t": 24.29,
    "e": 25.78,
    "w0": 61,
    "w1": 65
   },
   {
    "id": "b3",
    "text": "É a fita de um talk show de setenta e sete,",
    "t": 26.28,
    "e": 28.69,
    "w0": 65,
    "w1": 76
   },
   {
    "id": "b4",
    "text": "ao vivo, na noite de Halloween.",
    "t": 28.83,
    "e": 30.81,
    "w0": 76,
    "w1": 82
   },
   {
    "id": "b5",
    "text": "O apresentador leva uma menina possuída pro palco,",
    "t": 31.15,
    "e": 33.82,
    "w0": 82,
    "w1": 90
   },
   {
    "id": "b6",
    "text": "e perde o controle.",
    "t": 34.12,
    "e": 35.27,
    "w0": 90,
    "w1": 94
   },
   {
    "id": "b7",
    "text": "Tá na HBO Max.",
    "t": 35.72,
    "e": 37.01,
    "w0": 94,
    "w1": 98
   },
   {
    "id": "s1",
    "text": "Manda pra quem diz que não tem medo de nada.",
    "t": 37.46,
    "e": 39.72,
    "w0": 98,
    "w1": 108
   },
   {
    "id": "c1",
    "text": "E o número um,",
    "t": 40.17,
    "e": 40.99,
    "w0": 108,
    "w1": 112
   },
   {
    "id": "c2",
    "text": "que quase ninguém viu:",
    "t": 41.11,
    "e": 42.34,
    "w0": 112,
    "w1": 116
   },
   {
    "id": "c3",
    "text": "Gonjiam.",
    "t": 42.84,
    "e": 43.52,
    "w0": 116,
    "w1": 117
   },
   {
    "id": "c4",
    "text": "Uma equipe faz uma live dentro de um manicômio abandonado,",
    "t": 44.02,
    "e": 46.85,
    "w0": 117,
    "w1": 127
   },
   {
    "id": "c5",
    "text": "que existiu de verdade, na Coreia do Sul.",
    "t": 47.01,
    "e": 49.47,
    "w0": 127,
    "w1": 135
   },
   {
    "id": "c6",
    "text": "Cada um com uma câmera no rosto.",
    "t": 49.81,
    "e": 51.56,
    "w0": 135,
    "w1": 142
   },
   {
    "id": "c7",
    "text": "Tá no Prime Video.",
    "t": 51.98,
    "e": 53.07,
    "w0": 142,
    "w1": 146
   },
   {
    "id": "e1",
    "text": "Salva pra assistir no fim de semana.",
    "t": 53.52,
    "e": 55.53,
    "w0": 146,
    "w1": 153
   },
   {
    "id": "e2",
    "text": "Qual dos três te dá mais medo?",
    "t": 55.83,
    "e": 57.36,
    "w0": 153,
    "w1": 160
   },
   {
    "id": "e3",
    "text": "Comenta aqui.",
    "t": 57.58,
    "e": 58.39,
    "w0": 160,
    "w1": 162
   },
   {
    "id": "e4",
    "text": "E segue a talking horror pra mais",
    "t": 58.69,
    "e": 60.54,
    "w0": 162,
    "w1": 169
   }
  ]
 },
