  {
   "id": "gancho",
   "inicio": 0.0,
   "fim": 8.33,
   "frase": "Em mil novecentos e vinte e quatro, mandaram o Vasco cortar doze jogadores negros e pobres... e o Vasco disse: não!"
  },
  {
   "id": "fica",
   "inicio": 8.33,
   "fim": 10.59,
   "frase": "Fica até o final que eu explico."
  },
  {
   "id": "fundacao",
   "inicio": 10.59,
   "fim": 18.01,
   "frase": "Tudo começou em mil oitocentos e noventa e oito, quando remadores, a maioria portugueses, fundaram um clube de regatas no Rio."
  },
  {
   "id": "nome",
   "inicio": 18.01,
   "fim": 23.53,
   "frase": "O nome homenageia Vasco da Gama, que quatrocentos anos antes tinha chegado às Índias."
  },
  {
   "id": "camisas",
   "inicio": 23.53,
   "fim": 31.67,
   "frase": "No futebol, o Vasco subiu pra elite e, em mil novecentos e vinte e três, já foi campeão carioca, com um time de negros e operários."
  },
  {
   "id": "liga",
   "inicio": 31.67,
   "fim": 38.01,
   "frase": "Os grandes clubes criaram uma nova liga e exigiram que o Vasco cortasse doze desses jogadores."
  },
  {
   "id": "resposta",
   "inicio": 38.01,
   "fim": 45.85,
   "frase": "O presidente José Augusto Prestes respondeu por carta: o Vasco ficava com seus atletas. É a Resposta Histórica."
  },
  {
   "id": "saojanuario",
   "inicio": 45.85,
   "fim": 55.49,
   "frase": "E como diziam que o Vasco não tinha estádio, a torcida construiu um: São Januário, em mil novecentos e vinte e sete, o maior da América do Sul na época."
  },
  {
   "id": "expresso",
   "inicio": 55.49,
   "fim": 64.05,
   "frase": "Em mil novecentos e quarenta e oito, o Expresso da Vitória ganhou o Sul-Americano de Campeões, no Chile: o primeiro campeão continental de clubes."
  },
  {
   "id": "idolos",
   "inicio": 64.05,
   "fim": 72.47,
   "frase": "Depois vieram quatro Brasileiros, com ídolos como Roberto Dinamite, Edmundo e Romário... e a Libertadores de noventa e oito, no ano do centenário."
  },
  {
   "id": "cta",
   "inicio": 72.47,
   "fim": 78.0,
   "frase": "Qual time você quer ver explicado? Comenta aí e segue o arroba futexplicando!"
  }
