 "cenas": [
  {
   "id": "gancho",
   "inicio": 0.0,
   "fim": 5.06,
   "frase": "O torneio que hoje paga setenta e oito milhões de reais pro campeão..."
  },
  {
   "id": "ameaca",
   "inicio": 5.06,
   "fim": 10.06,
   "frase": "...nasceu com uma ameaça: quem não quisesse jogar, ia ser punido!"
  },
  {
   "id": "fica",
   "inicio": 10.06,
   "fim": 12.0,
   "frase": "Fica até o final que eu explico."
  },
  {
   "id": "comecou",
   "inicio": 12.0,
   "fim": 14.78,
   "frase": "Tudo começou em mil novecentos e oitenta e nove."
  },
  {
   "id": "teixeira",
   "inicio": 14.78,
   "fim": 17.8,
   "frase": "Ricardo Teixeira tinha acabado de assumir a CBF."
  },
  {
   "id": "estados",
   "inicio": 17.8,
   "fim": 22.68,
   "frase": "E os estados menores estavam bravos: tinham ficado fora da elite do Brasileirão."
  },
  {
   "id": "matamata",
   "inicio": 22.68,
   "fim": 26.32,
   "frase": "Aí ele inventou um mata-mata com campeões de todos os estados."
  },
  {
   "id": "numeros",
   "inicio": 26.32,
   "fim": 32.18,
   "frase": "Trinta e dois times, quarenta e seis dias e uma vaga na Libertadores pro campeão."
  },
  {
   "id": "primeiro",
   "inicio": 32.18,
   "fim": 36.0,
   "frase": "O primeiro campeão? O Grêmio, em cima do Sport."
  },
  {
   "id": "pequenos",
   "inicio": 36.0,
   "fim": 38.6,
   "frase": "E a Copa virou a chance dos pequenos."
  },
  {
   "id": "criciuma",
   "inicio": 38.6,
   "fim": 42.14,
   "frase": "Em noventa e um, o Criciúma foi campeão em cima do Grêmio."
  },
  {
   "id": "santoandre",
   "inicio": 42.14,
   "fim": 46.34,
   "frase": "Em dois mil e quatro, o Santo André calou o Maracanã contra o Flamengo."
  },
  {
   "id": "paulista",
   "inicio": 46.34,
   "fim": 50.6,
   "frase": "E em dois mil e cinco, o Paulista de Jundiaí bateu o Fluminense."
  },
  {
   "id": "semlibertadores",
   "inicio": 50.6,
   "fim": 54.34,
   "frase": "Mas até dois mil e doze, quem jogava a Libertadores nem participava."
  },
  {
   "id": "oitavas",
   "inicio": 54.34,
   "fim": 60.06,
   "frase": "Em dois mil e treze, os grandes passaram a entrar nas oitavas... e as zebras sumiram."
  },
  {
   "id": "maiores",
   "inicio": 60.06,
   "fim": 65.48,
   "frase": "O maior campeão é o Cruzeiro, com seis taças. Grêmio e Flamengo têm cinco."
  },
  {
   "id": "hoje",
   "inicio": 65.48,
   "fim": 71.58,
   "frase": "Hoje são cento e vinte e seis clubes, e a final de dois mil e vinte e seis é em jogo único, em Brasília."
  },
  {
   "id": "impacto",
   "inicio": 71.58,
   "fim": 75.46,
   "frase": "De torneio imposto na marra... à taça que vale uma fortuna."
  },
  {
   "id": "cta",
   "inicio": 75.46,
   "fim": 79.0,
   "frase": "Segue o arroba futexplicando!"
  }
 ],
